# Model API (OpenAI-compatible). For other providers, set OPENAI_BASE_URL and
# OPENAI_MODEL accordingly (e.g. a self-hosted vLLM endpoint).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4
OPENAI_TEMPERATURE=0
OPENAI_MAX_TOKENS=8192
# Optional thinking/reasoning toggle for endpoints that support it: "" | disabled | enabled
OPENAI_THINKING=

# Path to the downloaded dataset root (contains Python/ R/ C_CPP/ index.tsv ...)
MMSCI_DATA_ROOT=
# Docker image index; defaults to $MMSCI_DATA_ROOT/index.tsv when unset
MMSCI_IMAGE_INDEX=
# Env file mounted into the container as the model credentials (defaults to ./.env)
MMSCI_EVAL_ENV_FILE=

MMSCI_EVAL_TIMEOUT=600
MMSCI_INSTALL_OPENAI=1
MMSCI_DOCKER_GPU=0

# Optional: local dir or HF model id for the real tokenizer used in prompt
# token-budget accounting (e.g. Qwen/Qwen2.5-7B). Unset = char/3 heuristic.
MMSCI_QWEN_TOKENIZER=
